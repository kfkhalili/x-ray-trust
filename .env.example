# ─────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────

# RapidAPI key for the X (Twitter) data provider.
#   1. Create an account at https://rapidapi.com
#   2. Subscribe to an X/Twitter API — the app defaults to "twitter241":
#      https://rapidapi.com/davethebeast/api/twitter241
#      (each RapidAPI API needs its own subscription; the cheapest paid plan,
#      about $1/mo for 1000 requests, is plenty for an MVP)
#   3. Copy your key ("X-RapidAPI-Key") here.
RAPIDAPI_KEY=your_rapidapi_key_here


# ─────────────────────────────────────────────────────────────
# OPTIONAL — sensible defaults; uncomment only to override
# ─────────────────────────────────────────────────────────────

# RapidAPI host. Set this ONLY if you subscribed to a different X API than the
# default. Default: twitter241.p.rapidapi.com
# RAPIDAPI_HOST=twitter241.p.rapidapi.com

# Billing protection: monthly cap on paid upstream calls. Once this many calls
# are made in a calendar month the app stops hitting the API (returns a
# "capacity" response). Default: 950 (headroom under a 1000/month plan).
# RAPIDAPI_MONTHLY_BUDGET=950
