# X data provider — RapidAPI
# 1. Create a RapidAPI account: https://rapidapi.com
# 2. Subscribe to an X/Twitter API (default: "twitter241" by davethebeast —
#    https://rapidapi.com/davethebeast/api/twitter241). Its free tier suits an MVP.
# 3. Copy your RapidAPI key ("X-RapidAPI-Key") below.
RAPIDAPI_KEY=your_rapidapi_key_here

# Optional: override the RapidAPI host if you subscribe to a different X API.
# Defaults to twitter241.p.rapidapi.com
# RAPIDAPI_HOST=twitter241.p.rapidapi.com

# Application URL (optional, defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
